# LinguaLens Environment Configuration Example

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-a-strong-32-byte-hex-string

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database (PostgreSQL with pgvector for production; SQLite fallback for standalone local dev)
DATABASE_URL=postgresql+asyncpg://lingualens:lingualens_secret@localhost:5432/lingualens_db
# SQLite Local Development Fallback:
# DATABASE_URL=sqlite+aiosqlite:///./lingualens.db

# Vector Search Engine ("pgvector" or "numpy_in_memory")
VECTOR_BACKEND=numpy_in_memory

# Task Queue & Cache (Redis & Celery in production; "async_background" for zero-dependency local dev)
TASK_ENGINE=async_background
REDIS_URL=redis://localhost:6379/0

# PyTorch / ML Inference
TORCH_DEVICE=cpu
DEFAULT_EMBEDDING_BATCH_SIZE=32
HF_HOME=./models_cache
TRANSFORMERS_OFFLINE=0

# Frontend API Target
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
